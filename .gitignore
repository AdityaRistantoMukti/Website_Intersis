# ─── Dependencies ─────────────────────────────
node_modules/
**/node_modules/

# ─── Environment & Secret Keys (SENSITIVE) ───
.env
.env.*
!.env.example

# ─── Build & Output ───────────────────────────
dist/
dist-ssr/
build/
.vite/
*.local

# ─── File Uploads (Media / User Uploads) ──────
